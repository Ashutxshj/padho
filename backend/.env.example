# Environment Configuration
PROJECT_NAME="BookLeaf Author Support & Communication Portal"
API_V1_STR="/api/v1"
SECRET_KEY="bookleaf_secret_key_change_in_production_jwt_signing_token_123"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Use SQLite for fast local development and testing
DATABASE_URL="sqlite+aiosqlite:///./bookleaf.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/bookleaf"

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# AI Provider Configuration (optional: if omitted, deterministic MockAIService is used)
AI_PROVIDER="mock"  # "mock", "openai", "anthropic", or "gemini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
